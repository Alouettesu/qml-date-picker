import QmlProject

Project {
    mainFile: "qml/main.qml"
    mainUiFile: "qml/main.qml"

    /* Include .qml, .js, and image files from current directory and subdirectories */
    QmlFiles {
        directory: "qml"
    }

    QmlFiles {
        directory: "imports"
    }

    JavaScriptFiles {
        directory: "qml"
    }

    JavaScriptFiles {
        directory: "imports"
    }

    ImageFiles {
        directory: "qml"
    }

    ImageFiles {
        directory: "imports"
    }

    Files {
        filter: "qmldir"
        directory: "."
    }

    Environment {
        QT_AUTO_SCREEN_SCALE_FACTOR: "1"
        QML_COMPAT_RESOLVE_URLS_ON_ASSIGNMENT: "1"
        QT_LOGGING_RULES: "qt.qml.connections=false"
        QT_ENABLE_HIGHDPI_SCALING: "0"
    }

    qt6Project: true

    /* List of plugin directories passed to QML runtime */
    importPaths: [ "imports" ]

    /* Required for deployment */
    targetDirectory: "/opt/DatePickerDemo"

    qdsVersion: "4.1"

    quickVersion: "6.5"

    widgetApp: false

    multilanguageSupport: true
    supportedLanguages: ["en"]
    primaryLanguage: "en"
}
